# 주의: 값 뒤에 주석(#)을 붙이지 말 것 — systemd 는 그것까지 값으로 읽음.

# ===== 오너가 채울 값 (지금은 STUB) =====
# 관리자 텔레그램 숫자 ID (봇에 /id 보내면 나옴), 쉼표로 여러 명
ADMIN_IDS=
# 받는 USDT(TRC20) 주소 T... (비어 있으면 입금 안내를 막음)
PAY_ADDRESS=
# 고객에게 보이는 이름
BOT_NAME=
# 고객센터 텔레그램 @아이디
SUPPORT=
# @BotFather 토큰 — 서버에서만 넣을 것, 채팅에 붙이지 말 것
BOT_TOKEN=

# ===== 설치 스크립트가 채움 =====
DATABASE_URL=
ADMIN_SECRET=
# 관리 페이지 주소 (https://...), Caddy 가 이 도메인으로 인증서를 받음
ADMIN_BASE_URL=

# ===== 선택 =====
# trongrid.io 무료 API 키 (없으면 호출 한도가 낮음)
TRONGRID_KEY=
# 메인 메뉴 사진 (URL 또는 file_id)
MENU_PHOTO=
